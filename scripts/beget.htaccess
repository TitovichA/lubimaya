# Beget: PHP 8.1+ (auth API needs 7.4+)
AddHandler application/x-httpd-php81 .php

# Protect secrets
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>
<FilesMatch "^\.auth_attempts">
  Require all denied
</FilesMatch>

# Block direct access to env-like files
RewriteEngine On
RewriteRule ^\.env - [F,L]
RewriteRule ^\.auth_attempts - [F,L]

# SPA fallback (keep real files & api)
RewriteBase /
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule . /index.html [L]
